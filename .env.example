# Runtime defaults. The application reads these from the process environment.
# No value in this file is a secret.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=gpt-oss:120b-cloud

# Optional semantic-evaluation configuration. Not required to run the API/UI.
GEMINI_JUDGE_MODEL=gemini-3.6-flash
OLLAMA_JUDGE_MODEL=gpt-oss:120b-cloud

# Set GEMINI_API_KEY or GOOGLE_API_KEY only in your local process environment
# when intentionally running the optional Gemini judge. Never store it here.
